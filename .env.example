# Runtime mode: demo is the safe default; cloud/live requires a reachable DataHub GMS
DATAHUB_MODE=demo

# DataHub Cloud-compatible variables
DATAHUB_CLOUD_URL=https://your-workspace.example
DATAHUB_CLOUD_TOKEN=

# Self-hosted DataHub OSS on the hackathon VPS. Token is optional for the local quickstart.
DATAHUB_GMS_URL=http://194.113.74.21:8080
DATAHUB_GMS_TOKEN=

# Mutations stay disabled unless explicitly enabled server-side.
DATAHUB_ALLOW_MUTATIONS=false

# Model provider; optional in demo mode
MODEL_API_KEY=
MODEL_NAME=

# Optional local MCP bridge for Hermes/OpenClaw
SENTINEL_MCP_PORT=7331
SENTINEL_PUBLIC_BASE_URL=http://localhost:3000
